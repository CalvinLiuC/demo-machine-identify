{
  "name": "kinematic-scene-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/prepare-assets.mjs && vite build --configLoader native",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests e2e scripts index.html vite.config.ts playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.7"
  }
}
